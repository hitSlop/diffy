---
import Page from '../layouts/Page.astro';
import Mascot from '../components/Mascot.astro';
import { platforms, price } from '../data/releases';
import { getImage } from 'astro:assets';
import screenshot from '../../public/diffy.webp';
const variants = await Promise.all([480, 960, 1440].map(width => getImage({ src: screenshot, width, format: 'webp', quality: 90 })));
const screenshotSet = [...variants.map((image, index) => `${image.src} ${[480, 960, 1440][index]}w`), '/diffy.webp 1920w'].join(', ');
const checkout = import.meta.env.DODO_CHECKOUT_URL?.trim();
let purchaseUrl;
if (checkout) {
  const url = new URL(checkout);
  if (url.protocol !== 'https:' || url.hostname !== 'checkout.dodopayments.com') {
    throw new Error('DODO_CHECKOUT_URL must be an HTTPS Dodo hosted checkout URL.');
  }
  url.searchParams.set('redirect_url', 'https://diffy.hitslop.com/thanks');
  purchaseUrl = url.href;
}
---
<Page>
  <main id="main">
    <section class="hero frame" aria-labelledby="hero-title">
      <h1 id="hero-title" class="visually-hidden">Diffy — i literally only show you diffs</h1>
      <Mascot />
      <p class="intro">A native Git diff viewer, built in Rust.</p>
      <p class="agent-line">Keep up with your agents’ changes.</p>
      <ul class="hero-badges" aria-label="Highlights">
        <li>Freakishly fast</li>
        <li>Keyboard shortcuts galore</li>
      </ul>
      <p class="compatibility">{platforms.map((platform, index) => <>{index > 0 && <span aria-hidden="true"> · </span>}{platform.name} {platform.stage.toLowerCase()}</>)} <span aria-hidden="true">·</span> Requires Git</p>
      <div class="purchase">
        <p class="beta-price"><span class="visually-hidden">Regular price </span><s>{price.regular}</s> <strong>{price.beta}</strong><span> during beta</span></p>
        {purchaseUrl ? <a target="_blank" rel="noopener" class="button" href={purchaseUrl}>Buy once <span aria-hidden="true">—</span> {price.beta} <span class="button-arrow" aria-hidden="true">↗</span></a> : <button class="button" disabled aria-describedby="checkout-note">Buy once <span aria-hidden="true">—</span> {price.beta} <span class="button-arrow" aria-hidden="true">↗</span></button>}
        {!purchaseUrl && <p id="checkout-note" class="checkout-note">Checkout coming soon.</p>}
        <a target="_blank" rel="noopener" class="build-link" href="https://github.com/hitSlop/Diffy">Or build for free <span aria-hidden="true">↗</span></a>
        <p class="support-note">One purchase. All platforms. Your purchase supports Diffy.</p>
      </div>
    </section>
    <figure class="screenshot frame">
      <a href="/diffy.webp" target="_blank" rel="noopener" aria-label="Open the full-resolution Diffy screenshot in a new tab">
        <img src="/diffy.webp" srcset={screenshotSet} width="1920" height="1049" sizes="(max-width: 600px) calc(100vw - 36px), (max-width: 1224px) calc(100vw - 64px), 1160px" alt="Diffy in split view: original and changed code, project icons with change-count badges on the left, a searchable file list grouped by directory on the right, and keyboard shortcuts along the bottom." decoding="async" />
      </a>
      <figcaption>Real app. Real diffs. <span>Click to take a closer look ↗</span></figcaption>
    </figure>
    <section class="features frame" aria-labelledby="features-title">
      <h2 id="features-title">A few things it does.</h2>
      <dl>
        <div class="feature-row">
          <dt>Keep your worktrees together.</dt>
          <dd>
            <p>One project in the sidebar, with your Git worktrees in tabs across the top. Switch checkouts without losing your selected file or reading position. New worktrees appear automatically, and each checkout keeps its own staged and unstaged changes.</p>
            <div class="shortcuts"><span><kbd>⌘←</kbd><kbd>⌘→</kbd> Worktrees</span></div>
          </dd>
        </div>
        <div class="feature-row">
          <dt>Read GitHub pull requests.</dt>
          <dd><p>Switch between worktrees and read-only PR diffs without checking out a branch. Search open and draft PRs by title or number, and load more as you go. Loading indicators show when PRs and diffs are being fetched. Uses your existing GitHub CLI login for public and private repositories.</p></dd>
        </div>
        <div class="feature-row">
          <dt>Stay on the keyboard.</dt>
          <dd>
            <p>Jump between files and projects. Find a command without hunting for a button.</p>
            <div class="shortcuts"><span><kbd>⌘P</kbd> Commands</span><span><kbd>⌘↑</kbd><kbd>⌘↓</kbd> Files</span><span><kbd>⇧⌘↑</kbd><kbd>⇧⌘↓</kbd> Projects</span></div>
            <p class="terminal-note">Use ⌘ on macOS and Ctrl on Windows/Linux. Install the terminal command, then start with <code>diffy .</code></p>
          </dd>
        </div>
        <div class="feature-row">
          <dt>Find your agent projects.</dt>
          <dd><p>Find local Git projects from Herdr, Codex, and Claude Code in one list, with duplicates merged and recently active projects first. Repositories in system temporary folders are hidden. Pick the projects you want to import, and refresh the list whenever you need it.</p></dd>
        </div>
        <div class="feature-row">
          <dt>See changes as they happen.</dt>
          <dd><p>Local diffs refresh as you edit. Staged and unstaged changes stay separate. Stage a file, or all of them, when you’re ready.</p></dd>
        </div>
        <div class="feature-row">
          <dt>Make projects feel familiar.</dt>
          <dd><p>Give each project a name, color, emoji, or image. Right-click its icon to open the current checkout in your file manager, terminal, or editor.</p></dd>
        </div>
        <div class="feature-row">
          <dt>Read at your own pace.</dt>
          <dd><p>Choose split or unified diffs, adjust the font size, and wrap long lines. Large reviews load the file you’re reading and keep your place as changes arrive.</p></dd>
        </div>
        <div class="feature-row">
          <dt>Something while you wait.</dt>
          <dd><p>No changes yet? Play a little Snake in the empty diff pane. Press Enter to start or pause, and steer with the arrow keys.</p></dd>
        </div>
      </dl>
    </section>
  </main>
</Page>
